---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { url, agentsUrl } from '../lib/links';
import { site } from '../data/site';
interface Props { title?: string; description?: string; path: string }
const { title, description = site.description, path } = Astro.props;
const full = title ? `${title} · ${site.name}` : `${site.name}: ${site.tagline}`;
const canonical = Astro.site ? new URL(url(path), Astro.site).href : undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{full}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={full} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="alternate" type="text/plain" title="Agent-readable version of this page" href={agentsUrl(path)} />
  </head>
  <body>
    <Header path={path} />
    <main><slot /></main>
    <Footer path={path} />
  </body>
</html>
