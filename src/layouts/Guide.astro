---
import Base from './Base.astro';
import { byPart, chapters, type Chapter } from '../lib/guide';
import { url, guideUrl, agentsUrl } from '../lib/links';
import { parts } from '../data/site';
interface Props { chapter: Chapter; headings: { depth: number; slug: string; text: string }[] }
const { chapter, headings } = Astro.props;
const groups = await byPart();
const all = await chapters();
const i = all.findIndex((c) => c.id === chapter.id);
const prev = all[i - 1];
const next = all[i + 1];
const part = parts.find((p) => p.id === chapter.data.part)!;
const related = chapter.data.related.map((id) => all.find((c) => c.id === id)).filter((c): c is Chapter => Boolean(c));
const path = `/guide/${chapter.id}/`;
const toc = headings.filter((h) => h.depth === 2);
---
<Base title={chapter.data.title} description={chapter.data.summary} path={path}>
  <div class="wrap guide">
    <aside class="side">
      <nav aria-label="Guide">
        {groups.map((g) => (
          <>
            <h2>{g.title}</h2>
            <ol>{g.chapters.map((c) => <li><a href={guideUrl(c.id)} aria-current={c.id === chapter.id ? 'page' : undefined}>{c.data.title}</a></li>)}</ol>
          </>
        ))}
      </nav>
      <details>
        <summary>Guide contents</summary>
        <nav aria-label="Guide contents">
          {groups.map((g) => (
            <>
              <h2>{g.title}</h2>
              <ol>{g.chapters.map((c) => <li><a href={guideUrl(c.id)} aria-current={c.id === chapter.id ? 'page' : undefined}>{c.data.title}</a></li>)}</ol>
            </>
          ))}
        </nav>
      </details>
    </aside>

    <article class="article">
      <p class="crumb"><a href={url('/guide/')}>Guide</a> / {part.title}</p>
      <h1>{chapter.data.title}</h1>
      <p class="summary">{chapter.data.summary}</p>
      <div class="prose"><slot /></div>

      {related.length > 0 && (
        <section class="related">
          <h2>Related chapters</h2>
          <ul>{related.map((c) => <li><a href={guideUrl(c.id)}>{c.data.title}</a> <span>{c.data.summary}</span></li>)}</ul>
        </section>
      )}
      <nav class="pager" aria-label="Chapter">
        {prev && <a class="prev" href={guideUrl(prev.id)}><small>Previous</small><b>{prev.data.title}</b></a>}
        {next && <a class="next" href={guideUrl(next.id)}><small>Next</small><b>{next.data.title}</b></a>}
      </nav>
    </article>

    <aside class="onpage">
      {toc.length > 0 && (
        <>
          <h2>On this page</h2>
          <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
        </>
      )}
      <a class="txt" href={agentsUrl(path)}>agents.txt</a>
    </aside>
  </div>
</Base>

<script>
  // Highlight the section being read in the "On this page" list.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.onpage ol a')];
  if (links.length && 'IntersectionObserver' in window) {
    const byId = new Map(links.map((a) => [decodeURIComponent(a.hash.slice(1)), a]));
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        links.forEach((a) => a.classList.remove('on'));
        byId.get(e.target.id)?.classList.add('on');
      }
    }, { rootMargin: '-15% 0px -75% 0px' });
    byId.forEach((_, id) => { const h = document.getElementById(id); if (h) io.observe(h); });
  }
</script>
