---
import Base from '../../layouts/Base.astro';
import GuideIndex from '../../components/GuideIndex.astro';
import { chapters } from '../../lib/guide';
import { guideUrl, url } from '../../lib/links';
const first = (await chapters())[0]!;
---
<Base title="Guide" description="CanonBall, one concept per chapter: the primitives, the structure, how a change moves, verification engineering, and how to start." path="/guide/">
  <div class="wrap">
    <header class="page-head">
      <p class="eyebrow">The guide</p>
      <h1>CanonBall, one concept per chapter.</h1>
      <p class="sub">Read it in order the first time. Each chapter defines its terms before using them, shows a worked example from a refunds service, and says what the idea costs. The <a href={url('/glossary/')}>glossary</a> has every term in one place.</p>
      <p class="cta" style="margin-top:22px"><a class="btn" href={guideUrl(first.id)}>Start with chapter one</a></p>
    </header>
    <GuideIndex />
  </div>
</Base>
