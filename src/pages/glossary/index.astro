---
import Base from '../../layouts/Base.astro';
import { glossary } from '../../data/glossary';
import { guideUrl } from '../../lib/links';
---
<Base title="Glossary" description="Every CanonBall term in one place, each with the chapter that explains it." path="/glossary/">
  <div class="wrap">
    <header class="page-head">
      <p class="eyebrow">Reference</p>
      <h1>Glossary</h1>
      <p class="sub">Every term the guide uses. Where the specification uses a different word, it is shown in brackets. The chapter on sources says where each term comes from.</p>
    </header>
    <dl class="gloss">
      {glossary.map((g) => (
        <div id={g.term.toLowerCase().replace(/[^a-z0-9]+/g, '-')}>
          <dt>{g.term}{g.formal && <small>[{g.formal}]</small>}</dt>
          <dd>{g.def} <a href={guideUrl(g.slug)}>Read more &rarr;</a></dd>
        </div>
      ))}
    </dl>
  </div>
</Base>
