---
// The conveyor: requests gather into milestones, pass seven stations, and leave as CanonBalls.
// The scene is drawn here; the script below moves the work along it.
import Who from './Who.astro';
import { stations, ideas } from '../data/workflow';
import { guideUrl } from '../lib/links';
interface Props { /** Inside a chapter: no idea cards, and the stations also listed as text. */ compact?: boolean }
const { compact = false } = Astro.props;
const showIdeas = !compact;
const X = [12, 27, 42, 57, 70, 81, 93];
---
<div class:list={['cv', compact && 'compact']} data-conveyor>
  <div class="cv-bar">
    <div class="cv-ctl"><button class="main" type="button" data-toggle>Pause</button><button type="button" data-step>Step</button></div>
    <div class="cv-keys">
      <Who kind="p" label="person" /><Who kind="a" label="agent" />
      <span><i class="k-doc"></i>promises, decisions, invariants recorded</span>
      <span><i class="k-ok">&check;</i>evidence</span>
      <span><i class="k-ball"></i>CanonBall</span>
    </div>
  </div>
  <p class="cv-hint">Scroll the belt sideways to follow it.</p>

  <div class="cv-frame" tabindex="0" role="group" aria-label="Animated diagram: work moving from requests to a running system. It scrolls sideways. The same content follows as text.">
    <div class="cv-scene notrans" data-scene aria-hidden="true">
      <div class="cv-chamber"><span>verification<br />environment</span></div>
      <div class="cv-ret"></div>
      <div class="cv-belt"></div>
      <div class="cv-belt x"></div>
      <span class="cv-lane" style="top:238px">milestones</span>
      <span class="cv-lane" style="top:296px; left:8.5%">express belt: repairs and upkeep</span>
      <span class="cv-fwd">Forward pressure &rarr; requests</span>
      <span class="cv-back">&larr; Back pressure: incidents, bugs, reliability</span>
      <div class="cv-stack"><i></i><i></i><i></i></div>
      <div class="cv-gate open" data-gate></div>
      <div class="cv-eye" style="left:42%"></div><div class="cv-eye" style="left:57%"></div><div class="cv-eye" style="left:93%"></div>
      <div class="cv-rail"><b>Observability</b><span>logs &middot; traces &middot; metrics &middot; state &middot; replay</span></div>
      <span class="cv-badge" style="left:16.5%; top:132px">1</span>
      <span class="cv-badge" style="left:63.2%; top:110px">2</span>
      <span class="cv-badge" style="left:34.4%; top:306px">3</span>
      {stations.map((s, i) => (
        <div class="cv-st" data-st={i} style={`left:${X[i]}%`}>
          <b>{s.name}</b>
          <small data-sub>{s.sub}</small>
          <div class="cv-who">
            {s.agents.map((n) => <Who kind="a" label={n} />)}
            {s.people.map((n) => <Who kind="p" label={n} />)}
            {s.sometimes?.map((x) => <Who kind="p" label={x.short ?? x.who} class="crit" />)}
            {s.program && <Who kind="v" label={s.program} />}
          </div>
        </div>
      ))}
    </div>
  </div>

  <ol class="cv-list">
    {stations.map((s) => (
      <li>
        <a href={guideUrl(s.id)}><b>{s.name}</b></a>
        <span>{s.does}</span>
        <span class="cv-who">
          {s.agents.map((n) => <Who kind="a" label={n} />)}
          {s.people.map((n) => <Who kind="p" label={n} />)}
          {s.sometimes?.map((x) => <Who kind="p" label={`${x.who}, ${x.when}`} />)}
          {s.program && <Who kind="v" label={s.program} />}
        </span>
      </li>
    ))}
  </ol>

  {showIdeas && (
    <div class="cv-ideas">
      {ideas.map((d) => (
        <div class="cv-idea">
          <div class="top"><span class="cv-badge">{d.n}</span><h3>{d.title}</h3></div>
          <p>{d.text} <b>{d.strong}</b></p>
          <a class="more" href={guideUrl(d.slug)}>Read more<span class="sr"> about {d.title}</span></a>
        </div>
      ))}
    </div>
  )}
</div>

<style is:global>
  .cv { display: grid; gap: 14px; }
  .cv-bar { display: flex; flex-wrap: wrap; gap: 10px 20px; align-items: center; justify-content: space-between; }
  .cv-ctl { display: flex; gap: 8px; }
  .cv-ctl button { font: 600 14.5px var(--sans); border: 1.5px solid var(--ink); background: var(--card); border-radius: 9px; padding: 7px 14px; cursor: pointer; }
  .cv-ctl button.main { background: var(--ink); color: var(--bg); }
  .cv-keys { display: flex; flex-wrap: wrap; gap: 6px 14px; font-size: 13.5px; color: var(--ink-3); align-items: center; }
  .cv-keys > span:not(.who) { display: inline-flex; align-items: center; gap: 6px; }
  .cv-keys .k-doc { width: 12px; height: 15px; border: 1.5px solid var(--people); border-radius: 2px; display: inline-block; padding: 2px; background: repeating-linear-gradient(180deg, transparent 0 3px, var(--people) 3px 4.5px) content-box; }
  .cv-keys .k-ok { width: 15px; height: 15px; border-radius: 50%; background: var(--verify); color: var(--card); font: 700 10px/15px var(--sans); text-align: center; display: inline-block; font-style: normal; }
  .cv-keys .k-ball { width: 13px; height: 13px; border-radius: 50%; background: var(--ink); display: inline-block; }
  .cv-hint { display: none; margin: 0; font-size: 13.5px; color: var(--ink-3); }

  .cv-frame { background: var(--card); border: 1px solid var(--line); border-radius: 18px; overflow-x: auto; }
  .cv-scene { position: relative; min-width: 900px; height: 396px; margin: 16px 10px 10px; }

  .cv-st { position: absolute; top: 0; width: 13.5%; transform: translateX(-50%); display: grid; gap: 3px; justify-items: center; text-align: center; }
  .cv-st b { font: 700 16px var(--display); }
  .cv-st small { font-size: 12px; line-height: 1.25; color: var(--ink-3); min-height: 2.5em; }
  .cv-who { display: flex; flex-wrap: wrap; gap: 3px; justify-content: center; }
  .cv-st .cv-who { flex-direction: column; align-items: center; flex-wrap: nowrap; }
  .cv-st .who { font-size: 11px; padding: 2px 7px 2px 5px; opacity: 0.45; transition: opacity 0.4s; }
  .cv-st .who svg { width: 11px; height: 11px; }
  .cv-st.busy .who { opacity: 1; }
  .cv-st .who.crit, .cv-st.busy .who.crit { opacity: 0.3; }
  .cv-st.human .who.crit { opacity: 1; }

  .cv-belt { position: absolute; left: 1%; right: 1%; top: 222px; height: 12px; border-radius: 6px; background: repeating-linear-gradient(90deg, var(--ink) 0 12px, var(--ink-3) 12px 24px); background-size: 24px 100%; animation: cv-roll 1.1s linear infinite; }
  .cv-belt.x { left: 8%; top: 284px; height: 7px; opacity: 0.8; }
  @keyframes cv-roll { to { background-position-x: 24px; } }
  .cv.paused .cv-belt { animation-play-state: paused; }
  .cv-lane, .cv-fwd, .cv-back, .cv-chamber span { font: 500 10.5px var(--mono); letter-spacing: 0.07em; text-transform: uppercase; }
  .cv-lane { position: absolute; left: 1%; color: var(--ink-3); }
  .cv-fwd { position: absolute; left: 0; top: 150px; width: 9%; line-height: 1.35; color: var(--people); }
  .cv-back { position: absolute; left: 6%; top: 375px; color: var(--ink-3); }
  .cv-chamber { position: absolute; left: 49.5%; width: 15%; top: 120px; height: 180px; border: 2px solid var(--verify); border-radius: 14px; background: var(--verify-soft); }
  .cv-chamber span { position: absolute; left: 0; right: 0; top: 7px; text-align: center; color: var(--verify); line-height: 1.3; }
  .cv-gate { position: absolute; left: 70%; top: 158px; width: 5px; height: 64px; margin-left: 40px; border-radius: 3px; background: var(--warn); transform-origin: top; transition: transform 0.5s; }
  .cv-gate.open { transform: scaleY(0.18); }
  .cv-rail { position: absolute; left: 35.5%; right: 1%; top: 318px; height: 26px; border-radius: 8px; background: var(--ink); color: var(--bg); display: flex; align-items: center; gap: 12px; padding: 0 12px; white-space: nowrap; overflow: hidden; }
  .cv-rail b { font: 700 13.5px var(--display); }
  .cv-rail span { font: 500 11px var(--mono); opacity: 0.8; }
  .cv-eye { position: absolute; top: 291px; width: 0; height: 27px; border-left: 2px dotted var(--ink); }
  .cv-ret { position: absolute; left: 3%; right: 7%; top: 298px; height: 70px; border: 2px dashed var(--ink-3); border-top: 0; border-radius: 0 0 18px 18px; }
  .cv-ret::before { content: ''; position: absolute; left: -7px; top: -2px; border: 6px solid transparent; border-bottom-color: var(--ink-3); border-top: 0; }
  .cv-badge { position: absolute; width: 20px; height: 20px; border-radius: 50%; background: var(--warn); color: #14171d; font: 700 12px/20px var(--display); text-align: center; z-index: 4; }

  .cv-mv { position: absolute; transform: translate(-50%, -100%); transition: left 1.15s cubic-bezier(0.45, 0, 0.2, 1), top 1.15s cubic-bezier(0.45, 0, 0.2, 1), opacity 0.4s; z-index: 2; }
  .cv-scene.notrans .cv-mv, .cv-scene.notrans .cv-mv * { transition: none !important; }
  .cv-crate { width: 66px; height: 44px; }
  .cv-crate .box { position: absolute; inset: 0; border: 2px solid var(--ink); border-radius: 9px; background: var(--card); display: flex; gap: 4px; align-items: center; justify-content: center; transition: all 0.4s 0.7s; }
  .cv-crate .box i { width: 13px; height: 22px; border-radius: 3px; border: 1.5px solid var(--ink); opacity: 0.18; transition: all 0.4s 0.7s; }
  .cv-crate .box i.in { opacity: 1; }
  .cv-crate .tab { position: absolute; left: 50%; bottom: 100%; transform: translateX(-50%); font: 500 10px var(--mono); white-space: nowrap; padding-bottom: 3px; color: var(--ink-3); }
  .cv-crate .doc { position: absolute; right: -12px; top: 8px; width: 17px; height: 21px; border: 1.5px solid var(--people); border-radius: 3px; padding: 3px 2.5px; background: repeating-linear-gradient(180deg, var(--card) 0 3px, var(--people) 3px 4.5px) content-box, var(--card); opacity: 0; transform: scale(0.5); transition: all 0.4s 0.7s; }
  .cv-crate.shaped .doc { opacity: 1; transform: none; }
  .cv-crate.built .box i.in { background: var(--agents); border-color: var(--agents); }
  .cv-crate .ok { position: absolute; left: -8px; bottom: -6px; width: 18px; height: 18px; border-radius: 50%; background: var(--verify); color: var(--card); font: 700 11px/18px var(--sans); text-align: center; opacity: 0; transform: scale(0.5); transition: all 0.4s 0.7s; }
  .cv-crate.verified .ok { opacity: 1; transform: none; }
  .cv-crate.risky .tab::after { content: ' \00b7  critical'; color: var(--warn); }
  .cv-crate.ball { width: 40px; height: 40px; }
  .cv-crate.ball .box { border-radius: 50%; background: var(--ink); }
  .cv-crate.ball .box i, .cv-crate.ball .doc, .cv-crate.ball .ok { opacity: 0; }
  .cv-crate.ball .tab { color: var(--ink); }
  .cv-loose { width: 13px; height: 22px; border-radius: 3px; border: 1.5px solid var(--ink); background: var(--card); }
  .cv-fix { height: 20px; padding: 0 7px; border-radius: 5px; border: 1.5px dashed var(--ink); background: var(--card); font: 500 10px/17px var(--mono); white-space: nowrap; transition: left 1.15s cubic-bezier(0.45, 0, 0.2, 1), top 1.15s cubic-bezier(0.45, 0, 0.2, 1), opacity 0.4s, border-color 0.4s 0.7s; }
  .cv-fix.inc { border: 1.5px solid var(--warn); }
  .cv-fix.verified { border: 1.5px solid var(--verify); }
  .cv-fix.ball { width: 18px; height: 18px; padding: 0; border-radius: 50%; background: var(--ink); border: 0; color: transparent; }
  .cv-stack { position: absolute; left: 3%; top: 222px; transform: translate(-50%, -100%); display: flex; align-items: flex-end; }
  .cv-stack i { width: 13px; height: 22px; border-radius: 3px; border: 1.5px solid var(--ink); background: var(--card); }
  .cv-stack i:nth-child(2) { margin-left: -9px; margin-bottom: 3px; } .cv-stack i:nth-child(3) { margin-left: -9px; margin-bottom: 6px; }

  .cv-list { display: none; list-style: none; margin: 0; padding: 0; gap: 10px; counter-reset: st; }
  .cv-list li { counter-increment: st; background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 12px 14px; display: grid; gap: 6px; font-size: 15px; }
  .cv-list li a { text-decoration: none; }
  .cv-list li b { font: 700 16px var(--display); }
  .cv-list li b::before { content: counter(st) '. '; color: var(--ink-3); }
  .cv-list li > span:first-of-type { color: var(--ink-2); }
  .cv-list .cv-who { justify-content: flex-start; }

  .cv-ideas { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  .cv-idea { background: var(--card); border: 1px solid var(--line); border-radius: 14px; padding: 16px; display: grid; gap: 8px; align-content: start; min-width: 0; }
  .cv-idea .top { display: flex; gap: 10px; align-items: center; }
  .cv-idea .cv-badge { position: static; flex: none; }
  .cv-idea h3 { margin: 0; font-size: 17px; line-height: 1.25; }
  .cv-idea p { margin: 0; font-size: 15.5px; color: var(--ink-2); }
  .cv-idea p b { color: var(--ink); font-weight: 600; }

  .cv.compact .cv-hint { display: block; }
  @media (max-width: 760px) {
    .cv-ideas { grid-template-columns: 1fr; }
    .cv-hint { display: block; }
    .cv-list { display: grid; }
  }
  @media (prefers-reduced-motion: reduce) { .cv-belt { animation: none; } .cv-mv, .cv-mv * { transition: none !important; } }
</style>

<script>
  // Positions along the belt, in percent of the scene's width, and belt heights in pixels.
  const X = [12, 27, 42, 57, 70, 81, 93] as const;
  const Y = { main: 222, exp: 284, ret: 378 };
  const REVIEW = 4, RELEASE = 5, OPERATE = 6;

  interface Crate { id: number; st: number; n: number; hold: number; risky: boolean; flyin?: boolean; gone?: boolean }
  interface Fix { ph: number }

  for (const root of document.querySelectorAll<HTMLElement>('[data-conveyor]')) {
    const scene = root.querySelector<HTMLElement>('[data-scene]')!;
    const gate = root.querySelector<HTMLElement>('[data-gate]')!;
    const heads = [...root.querySelectorAll<HTMLElement>('[data-st]')];
    const toggle = root.querySelector<HTMLButtonElement>('[data-toggle]')!;
    const els = new Map<object, HTMLElement>();
    let t = 0, seq = 12;
    let crates: Crate[] = [];
    let fix: Fix | null = null;

    const place = (el: HTMLElement, x: number, y: number) => { el.style.left = `${x}%`; el.style.top = `${y}px`; };
    const drop = (key: object) => { const el = els.get(key); if (el) { el.style.opacity = '0'; setTimeout(() => el.remove(), 500); } els.delete(key); };

    // One step of the belt. Work nearest the end moves first, so nothing overtakes.
    const tick = () => {
      t++;
      crates.sort((a, b) => b.st - a.st);
      const taken = new Set(crates.map((c) => c.st));
      for (const c of crates) {
        c.flyin = false;
        if (c.st === OPERATE) { c.gone = true; taken.delete(OPERATE); continue; }
        if (c.st === 0 && c.n < 3) { c.n++; c.flyin = true; continue; }
        // Every milestone is reviewed by an agent. A critical one also waits for a person.
        if (c.st === REVIEW && c.risky && c.hold < 2) { c.hold++; continue; }
        if (taken.has(c.st + 1)) continue;
        taken.delete(c.st); c.st++; taken.add(c.st);
      }
      crates = crates.filter((c) => { if (c.gone) drop(c); return !c.gone; });
      if (!crates.some((c) => c.st === 0)) { seq++; crates.push({ id: seq, st: 0, n: 1, hold: 0, risky: seq % 2 === 0, flyin: true }); }
      if (fix) { fix.ph++; if (fix.ph > 8) { drop(fix); fix = null; } }
      else if (t % 12 === 6) fix = { ph: 0 };
      render();
    };

    const render = () => {
      const busy = new Set<number>();
      for (const c of crates) {
        let el = els.get(c);
        if (!el) {
          el = document.createElement('div'); el.className = 'cv-mv cv-crate';
          el.innerHTML = '<span class="tab"></span><div class="box"><i></i><i></i><i></i></div><span class="doc"></span><span class="ok">✓</span>';
          place(el, X[0], Y.main); scene.append(el); els.set(c, el);
        }
        place(el, X[c.st]!, Y.main);
        el.classList.toggle('risky', c.risky && c.st < RELEASE);
        el.classList.toggle('shaped', c.st >= 1); el.classList.toggle('built', c.st >= 2);
        el.classList.toggle('verified', c.st >= 3); el.classList.toggle('ball', c.st >= RELEASE);
        el.querySelector('.tab')!.textContent = c.st >= RELEASE ? `CanonBall ${c.id}` : `M${c.id - 11}`;
        el.querySelectorAll('i').forEach((m, i) => m.classList.toggle('in', i < c.n));
        busy.add(c.st);
        if (c.flyin && !scene.classList.contains('notrans')) {
          const card = document.createElement('div'); card.className = 'cv-mv cv-loose'; place(card, 3, Y.main); scene.append(card);
          requestAnimationFrame(() => requestAnimationFrame(() => { place(card, X[0], Y.main - 10); card.style.opacity = '0.2'; }));
          setTimeout(() => card.remove(), 1200);
        }
      }
      if (fix) {
        let el = els.get(fix);
        if (!el) { el = document.createElement('div'); el.className = 'cv-mv cv-fix inc'; place(el, X[OPERATE], Y.exp + 30); scene.append(el); els.set(fix, el); }
        // An incident returns along the dashed line, then rides the express belt through the same stations.
        const path: [number, number, number | null][] = [
          [X[OPERATE], Y.ret, OPERATE], [3, Y.ret, null], [X[0], Y.exp, 0], [X[1], Y.exp, 1], [X[2], Y.exp, 2],
          [X[3], Y.exp, 3], [X[REVIEW], Y.exp, REVIEW], [X[RELEASE], Y.exp, RELEASE], [X[OPERATE], Y.exp, OPERATE],
        ];
        const [x, y, at] = path[fix.ph]!;
        place(el, x, y);
        el.classList.toggle('inc', fix.ph < 2); el.classList.toggle('verified', fix.ph >= 5); el.classList.toggle('ball', fix.ph >= 7);
        el.textContent = fix.ph < 2 ? 'incident' : 'fix';
        if (at !== null) busy.add(at);
      }
      const held = crates.some((c) => c.risky && c.st === REVIEW);
      heads.forEach((h, i) => { h.classList.toggle('busy', busy.has(i)); if (i === REVIEW) h.classList.toggle('human', held); });
      gate.classList.toggle('open', !crates.some((c) => c.risky && (c.st === REVIEW - 1 || c.st === REVIEW)));
      const running = crates.find((c) => c.st === OPERATE);
      if (running) heads[OPERATE]!.querySelector('[data-sub]')!.textContent = `running CanonBall ${running.id}`;
    };

    // Start with a belt already in motion, so the first frame shows work at every stage.
    crates = [{ id: 11, st: 4, n: 3, hold: 2, risky: false }, { id: 12, st: 1, n: 3, hold: 0, risky: true }];
    for (let i = 0; i < 9; i++) tick();
    void scene.offsetWidth;
    scene.classList.remove('notrans');

    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let timer: number | undefined;
    let wanted = !still;
    let visible = false;
    const sync = () => {
      const on = wanted && visible;
      if (on && !timer) timer = window.setInterval(tick, 1900);
      if (!on && timer) { clearInterval(timer); timer = undefined; }
      toggle.textContent = wanted ? 'Pause' : 'Play';
      root.classList.toggle('paused', !on);
    };
    toggle.addEventListener('click', () => { wanted = !wanted; sync(); });
    root.querySelector('[data-step]')!.addEventListener('click', () => { wanted = false; sync(); tick(); });
    // Run only while the diagram is on screen.
    new IntersectionObserver((entries) => { visible = entries.some((e) => e.isIntersecting); sync(); }, { threshold: 0.15 }).observe(root);
    sync();
  }
</script>
