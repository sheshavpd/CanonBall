---
import { dial } from '../data/site';
const pos = (v: number) => `calc(7px + (100% - 14px) * ${v / 5})`;
---
<div class="box" id="dial-control" data-rows={JSON.stringify(dial.rows.map((r) => r.v))} data-levels={JSON.stringify(dial.levels)}>
  <div class="seg" role="group" aria-label="Scenario">
    {dial.scenarios.map((s, i) => <button type="button" data-s={i} aria-pressed={i === 0 ? 'true' : 'false'}>{s}</button>)}
  </div>
  <div class="dends"><div></div><div><span class="p">People decide</span><span class="a">Agents act</span></div></div>
  {dial.rows.map((r) => (
    <div class="drow">
      <div class="dname"><b>{r.name}</b><span>{r.sub}</span></div>
      <div class="dtrack">
        {[0, 1, 2, 3, 4, 5].map((i) => <i class="stop" style={`left:${pos(i)}`}></i>)}
        <i class:list={['knob', r.lock && 'lock']} style={`left:${pos(r.v[0]!)}`}></i>
      </div>
      <div class="dstate" data-lock={r.lock ? '1' : undefined}>{dial.levels[r.v[0]!]}{r.lock ? '. This stays with people.' : '.'}</div>
    </div>
  ))}
</div>

<script>
  const root = document.getElementById("dial-control");
  if (root) {
    const values: number[][] = JSON.parse(root.dataset.rows ?? '[]');
    const levels: string[] = JSON.parse(root.dataset.levels ?? '[]');
    const knobs = [...root.querySelectorAll<HTMLElement>('.knob')];
    const states = [...root.querySelectorAll<HTMLElement>('.dstate')];
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('.seg button')];
    const set = (s: number) => values.forEach((v, i) => {
      const val = v[s]!;
      knobs[i]!.style.left = `calc(7px + (100% - 14px) * ${val / 5})`;
      knobs[i]!.classList.toggle('ag', val >= 3);
      states[i]!.textContent = levels[val] + (states[i]!.dataset.lock ? '. This stays with people.' : '.');
    });
    buttons.forEach((b) => b.addEventListener('click', () => {
      buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      set(Number(b.dataset.s));
    }));
  }
</script>
