---
import { rows, pathOf } from '../data/repo';
import { steps } from '../data/site';
import { guideUrl } from '../lib/links';
const firstOutside = rows.findIndex((r) => r.outside);
---
<div class="bench" id="bench" data-steps={JSON.stringify(steps)}>
  <div class="bench-steps">
    <span class="lbl">Follow a change</span>
    <button class="play" type="button" data-play>Play</button>
    {steps.map((s, i) => (
      <button type="button" class={s.k} data-step={i} aria-pressed="false"><i></i>{s.n}</button>
    ))}
    <button class="free" type="button" data-free>Browse freely</button>
  </div>
  <div class="bench-split">
    <div class="tree" data-tree aria-label="Example repository: a refunds service">
      {rows.map((r, i) => (
        <>
          {i === firstOutside && <div class="sep">Outside the repository</div>}
          <button type="button" class:list={['row', 'd' + r.depth, r.writer !== 'n' && r.writer, r.proposed && 'dim']} data-id={r.id} aria-current={i === 0 ? 'true' : undefined}>
            <span class="dot"></span>
            <span class="nm">{r.name}</span>
            {r.proposed ? <span class="tg" data-tag>proposed</span> : r.question && <span class="q">{r.question}</span>}
          </button>
        </>
      ))}
    </div>
    <div class="pane" aria-live="polite">
      <div class="narr" data-narr hidden></div>
      {rows.map((r, i) => (
        <article class="panel" data-panel={r.id} hidden={i !== 0}>
          <div class="ptop"><span class:list={['pill', r.writer !== 'n' && r.writer]}>{r.who}</span><code>{pathOf(r.id)}</code></div>
          <h3 class={r.id === 'verify' ? 'v' : undefined}>{r.title}</h3>
          <p>{r.what}</p>
          {r.note && <p class="note">{r.note}</p>}
          {r.file && <pre>{r.file}</pre>}
          <p><a class="more" href={guideUrl(r.more)}>Read the chapter</a></p>
        </article>
      ))}
    </div>
  </div>
</div>

<script>
  interface Step { n: string; say: string; ids: string[]; focus: string }
  const bench = document.getElementById('bench');
  if (bench) {
    const steps: Step[] = JSON.parse(bench.dataset.steps ?? '[]');
    const tree = bench.querySelector<HTMLElement>('[data-tree]')!;
    const rows = [...bench.querySelectorAll<HTMLButtonElement>('.row')];
    const panels = [...bench.querySelectorAll<HTMLElement>('[data-panel]')];
    const stepButtons = [...bench.querySelectorAll<HTMLButtonElement>('[data-step]')];
    const narr = bench.querySelector<HTMLElement>('[data-narr]')!;
    const play = bench.querySelector<HTMLButtonElement>('[data-play]')!;
    const tag = bench.querySelector<HTMLElement>('[data-tag]');
    let step = -1;
    let timer: number | undefined;

    const show = (id: string) => {
      rows.forEach((r) => (r.dataset.id === id ? r.setAttribute('aria-current', 'true') : r.removeAttribute('aria-current')));
      panels.forEach((p) => (p.hidden = p.dataset.panel !== id));
    };
    const paint = () => {
      const lit = step >= 0 ? steps[step]!.ids : [];
      const released = step >= 6;
      rows.forEach((r) => {
        r.classList.toggle('lit', lit.includes(r.dataset.id!));
        if (r.querySelector('[data-tag]')) r.classList.toggle('dim', !released);
      });
      if (tag) { tag.textContent = released ? 'released' : 'proposed'; tag.classList.toggle('on', released); }
      stepButtons.forEach((b, i) => b.setAttribute('aria-pressed', String(i === step)));
      narr.hidden = step < 0;
      if (step >= 0) {
        narr.replaceChildren();
        const b = document.createElement('b');
        b.textContent = `Step ${step + 1} of ${steps.length}: ${steps[step]!.n}. `;
        narr.append(b, steps[step]!.say);
      }
    };
    const go = (i: number) => {
      step = i; paint(); show(steps[i]!.focus);
      const first = rows.find((r) => r.dataset.id === steps[i]!.ids[0]);
      if (first) tree.scrollTop = Math.max(0, first.offsetTop - tree.offsetTop - 60);
    };
    const stop = () => { if (timer) { clearInterval(timer); timer = undefined; play.textContent = 'Play'; } };

    rows.forEach((r) => r.addEventListener('click', () => { stop(); show(r.dataset.id!); }));
    stepButtons.forEach((b, i) => b.addEventListener('click', () => { stop(); go(i); }));
    bench.querySelector('[data-free]')!.addEventListener('click', () => { stop(); step = -1; paint(); show('spec'); tree.scrollTop = 0; });
    play.addEventListener('click', () => {
      if (timer) { stop(); return; }
      play.textContent = 'Pause';
      go(step < 0 || step >= steps.length - 1 ? 0 : step + 1);
      timer = window.setInterval(() => {
        if (step >= steps.length - 1) { stop(); return; }
        go(step + 1);
        if (step >= steps.length - 1) stop();
      }, 3400);
    });
  }
</script>
