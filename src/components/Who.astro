---
// A labeled chip for someone who does work: a person, an agent, or a program.
interface Props { kind: 'p' | 'a' | 'v'; label: string; class?: string }
const { kind, label, class: cls } = Astro.props;
const what = { p: 'Person', a: 'Agent', v: 'Program' }[kind];
---
<span class:list={['who', kind, cls]}>
  <svg viewBox="0 0 16 16" aria-hidden="true">
    {kind === 'p' && <><circle cx="8" cy="4.8" r="3" /><path d="M2.3 14.2a5.7 5.7 0 0 1 11.4 0z" /></>}
    {kind === 'a' && <><rect x="2.2" y="5.2" width="11.6" height="8.6" rx="2.6" /><rect x="7.3" y="2.4" width="1.4" height="3" /><circle cx="8" cy="2.2" r="1.3" /><circle class="cut" cx="5.9" cy="9.3" r="1.25" /><circle class="cut" cx="10.1" cy="9.3" r="1.25" /></>}
    {kind === 'v' && <><rect x="2" y="2" width="12" height="12" rx="3" /><path class="cutline" d="M5 8.3l2.1 2.1L11.1 6.1" /></>}
  </svg><span class="sr">{what}: </span>{label}
</span>
