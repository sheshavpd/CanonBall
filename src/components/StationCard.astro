---
// Shown at the top of each walkthrough chapter: where we are on the conveyor, who works here, and what they read and write.
import Who from './Who.astro';
import { stations, type StationId } from '../data/workflow';
import { guideUrl } from '../lib/links';
import { compareUrl } from '../lib/repo';
interface Props { id: StationId }
const { id } = Astro.props;
const s = stations.find((x) => x.id === id)!;
---
<nav aria-label="Stations">
  <ol class="stations">
    {stations.map((x, i) => <li><a href={guideUrl(x.id)} aria-current={x.id === id ? 'page' : undefined}><i aria-hidden="true">{i + 1}</i>{x.name}</a></li>)}
  </ol>
</nav>
<div class="station">
  <dl>
    <dt>Who</dt>
    <dd>
      {[...s.agents, ...(s.alsoAgents ?? [])].map((n) => <Who kind="a" label={n} />)}
      {[...s.people, ...(s.alsoPeople ?? [])].map((n) => <Who kind="p" label={n} />)}
      {s.sometimes?.map((x) => <><Who kind="p" label={x.who} /><span class="cond">{x.when}</span></>)}
      {s.program && <Who kind="v" label={s.program} />}
    </dd>
    <dt>Reads</dt>
    <dd>{s.reads.map((r) => <code>{r}</code>)}</dd>
    <dt>Writes</dt>
    <dd>{s.writes.map((w) => <code>{w}</code>)}</dd>
    {s.diff && (
      <>
        <dt>In the repo</dt>
        <dd class="diffs">{s.diff.map((d) => <a href={compareUrl(d.from, d.to)}>{d.label ? `See ${d.label}` : 'See exactly what this station changed'} <span>{d.from}…{d.to}</span></a>)}</dd>
      </>
    )}
  </dl>
  {s.gate && <p class="gate"><b>{s.gate.name}:</b> {s.gate.text}</p>}
</div>
