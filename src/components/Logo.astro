---
// The mark: three concentric circles. Canon at the center, the build around it, the Record around that.
// Warm is what people decide, blue is what agents build, green is the evidence.
interface Props { title?: string }
const { title } = Astro.props;
---
<svg class="mark" viewBox="0 0 32 32" role={title ? 'img' : 'presentation'} aria-label={title} aria-hidden={title ? undefined : 'true'}>
  <circle cx="16" cy="16" r="13.6" fill="none" stroke="var(--mark-verify)" stroke-width="3.6" />
  <circle cx="16" cy="16" r="8.4" fill="none" stroke="var(--mark-agents)" stroke-width="3.6" />
  <circle cx="16" cy="16" r="4.4" fill="var(--mark-people)" />
</svg>
