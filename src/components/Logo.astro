---
// The mark: canon, build and Record, held together by one ring.
// Warm is what people decide, blue is what agents build, green is the evidence.
interface Props { title?: string }
const { title } = Astro.props;
const id = 'cb' + Math.random().toString(36).slice(2, 8);
---
<svg viewBox="0 0 32 32" role={title ? 'img' : 'presentation'} aria-label={title} aria-hidden={title ? undefined : 'true'}>
  <defs><clipPath id={id}><circle cx="16" cy="16" r="11.6" /></clipPath></defs>
  <g clip-path={`url(#${id})`}>
    <rect x="0" y="0" width="32" height="11.5" fill="var(--mark-people)" />
    <rect x="0" y="13" width="32" height="6" fill="var(--mark-agents)" />
    <rect x="0" y="20.5" width="32" height="11.5" fill="var(--mark-verify)" />
  </g>
  <circle cx="16" cy="16" r="14.6" fill="none" stroke="var(--ink)" stroke-width="1.6" />
</svg>
