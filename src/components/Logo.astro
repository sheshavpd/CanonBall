---
// The mark: one turn of the work, and a release leaving it.
// Warm is the canon people agree, blue is the build, green is the Verification Record.
// The ball that leaves the loop is the release: a CanonBall.
interface Props { title?: string }
const { title } = Astro.props;
---
<svg class="mark" viewBox="0 0 64 64" role={title ? 'img' : 'presentation'} aria-label={title} aria-hidden={title ? undefined : 'true'}>
  <g fill="none" stroke-width="7" stroke-linecap="round">
    <path d="M49.97 28.51 A21 21 0 0 1 40.5 53.19" stroke="var(--mark-people)" />
    <path d="M33.65 55.68 A21 21 0 0 1 10.27 42.18" stroke="var(--mark-agents)" />
    <path d="M9 35 A21 21 0 0 1 29.27 14.01" stroke="var(--mark-verify)" />
  </g>
  <circle cx="48.5" cy="11.5" r="6.2" fill="currentColor" />
</svg>
