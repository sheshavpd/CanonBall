---
import { byPart } from '../lib/guide';
import { guideUrl } from '../lib/links';
const groups = await byPart();
---
<div class="toc-grid">
  {groups.map((g) => (
    <section class="toc-part">
      <h3>{g.title}</h3>
      <p>{g.blurb}</p>
      <ol>
        {g.chapters.map((c) => (
          <li><a href={guideUrl(c.id)}><b>{c.data.title}</b><span>{c.data.summary}</span></a></li>
        ))}
      </ol>
    </section>
  ))}
</div>
